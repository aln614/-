{
  "name": "tenying-ai-lan-client",
  "version": "1.0.54",
  "description": "TENYING AI LAN access client",
  "main": "main.js",
  "private": true,
  "build": {
    "electronVersion": "35.7.5",
    "appId": "com.tenying.ai.lan.client",
    "productName": "TENYING_AI_LAN_Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../assets/rocket.ico",
        "to": "assets/rocket.ico"
      }
    ],
    "win": {
      "icon": "../assets/rocket.ico",
      "target": [
        "portable"
      ],
      "artifactName": "TENYING_AI_LAN_Client-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "forceCodeSigning": false
  }
}
